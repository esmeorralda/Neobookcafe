<div class="flex justify-center items-center min-h-screen" style="background-color: rgba(230, 225, 215, 0.7);">
  <div class="w-full max-w-md bg-white rounded-lg shadow-md p-8 login-form-container">
    <h2 class="login-form-title">회원가입</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "login-form" }) do |f| %>
<% if flash[:alert].present? %>
  <div role="alert"
       class="js-flash mb-4 rounded-xl border border-amber-200 bg-amber-50 text-amber-900 shadow-md">
    <div class="relative flex items-start gap-3 p-3">
      <!-- 아이콘 -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
           fill="currentColor" class="h-5 w-5 flex-shrink-0 text-amber-600">
        <path fill-rule="evenodd"
              d="M8.257 3.099c.765-1.36 2.72-1.36 3.485 0l6.518 11.596c.73 1.298-.19 2.905-1.742 2.905H3.48c-1.553 0-2.473-1.607-1.742-2.905L8.257 3.1zM11 14a1 1 0 10-2 0 1 1 0 002 0zm-1-2a.75.75 0 01-.75-.75V8.25a.75.75 0 011.5 0v3a.75.75 0 01-.75.75z"
              clip-rule="evenodd" />
      </svg>

      <!-- 메시지 -->
      <pre class="whitespace-pre-line font-sans text-sm leading-6 m-0"><%= flash[:alert] %></pre>

      <!-- 닫기 버튼 (옵션) -->
      <button type="button"
              class="absolute right-2 top-2 inline-flex h-7 w-7 items-center justify-center rounded-full hover:bg-amber-100"
              aria-label="닫기"
              onclick="this.closest('.js-flash')?.remove()">
        ✕
      </button>
    </div>

    <!-- 하단 강조선 -->
    <div class="h-1 w-full rounded-b-xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-400"></div>
  </div>
<% end %>

      <div>
        <%= f.label :email, "이메일", class: "login-form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "login-form-input" %>
      </div>

      <div>
        <%= f.label :password, "비밀번호", class: "login-form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", required: true,
            class: "login-form-input" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "비밀번호 확인", class: "login-form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
            class: "login-form-input" %>
      </div>

      <div>
        <%= f.label :name, "사용자 이름", class: "login-form-label" %>
        <%= f.text_field :name, autocomplete: "name", required: true,
            class: "login-form-input" %>
      </div>

      <div class="login-form-actions">
        <%= f.submit "회원가입", class: "login-form-submit" %>
      </div>
    <% end %>

   
  </div>
</div>

<style>
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
}

.login-form-container {
  color: #5a4a2a;
  background-color: rgba(255, 255, 255, 0.95);
}

.login-form-title {
  margin-bottom: 20px;
  font-weight: bold;
  font-size: 20px;
  text-align: center;
  text-shadow: 1px 1px 0 #d7d2c1;
}

.login-form-label {
  display: block;
  margin-bottom: 6px;
  font-weight: 600;
  color: #7c6243;
}

.login-form-input {
  width: 100%;
  padding: 10px 12px;
  margin-bottom: 15px;
  border: 1.8px solid #a5947b;
  border-radius: 6px;
  font-size: 15px;
  box-sizing: border-box;
  background-color: #faf7ef;
  color: #5a4a2a;
  transition: border-color 0.3s;
}

.login-form-input:focus {
  border-color: #7c6243;
  outline: none;
  background-color: #fff;
}

.login-form-actions {
  margin-top: 10px;
}

.login-form-submit {
  width: 100%;
  background-color: #7c6243;
  border: none;
  padding: 12px 0;
  font-size: 17px;
  color: #f7f3e9;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  box-shadow: 0 3px 5px rgba(124, 98, 67, 0.6);
  transition: background-color 0.3s;
}

.login-form-submit:hover {
  background-color: #5a4a2a;
}

.login-form-link {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 14px;
  color: #7c6243;
  text-decoration: underline;
  margin-top: 20px;
}

.login-form-register {
  margin-top: 20px;
  text-align: center;
}
</style>
