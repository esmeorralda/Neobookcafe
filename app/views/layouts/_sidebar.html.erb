<% if @show_sidebar %>
<style>
  /* 왼쪽 네비 전용 스코프 */
 #left-nav .sidebar-box { background:#efe9df; color:#9b825e; }
  #left-nav .sidebar-link {
    color:#9b825e !important; text-decoration:none; transition:color .15s ease;
  }
  #left-nav .sidebar-link:hover {
    color:#7b5845 !important; text-decoration:underline; text-underline-offset:2px;
  }
  #left-nav .sidebar-link.is-active {
    color:#7b5845 !important; font-weight:600; text-decoration:none;
  }
  #left-nav { transition: transform .25s ease; }

  /* 닫기 버튼 기본 스타일 (데스크탑에서는 숨김) */
#left-nav .sidebar-close{
  position:absolute; top:8px; right:8px;
  display:none;                        /* 데스크탑에서 숨김 */
  height:25px; width:25px;
  border:0; border-radius:30px;
  background:#efe9df; color:#5f4434;
  font-weight:800; line-height:1;
  box-shadow:0 1px 2px rgba(0,0,0,.06);
  cursor:pointer;

}
#left-nav .sidebar-close:hover{ background:#dccbb8; }

/* 모바일(<=1024px)에서만 표시 */
@media (max-width:1024px){
  #left-nav .sidebar-close{
    display:inline-flex; align-items:center; justify-content:center;
  }
}


  /* 모바일(<=1024px): 위치만 바꿈 (룩앤필 변경 금지) */
  @media (max-width: 1024px) {
    #left-nav{
      position:fixed; top:7rem; left:0;
      height:calc(100vh - 7rem);
      width:12rem;               /* w-48 동일 */
      transform:translateX(-110%);
      z-index:100001;            /* 버튼보다 아래 */
    }
    body.sidebar-open #left-nav{ transform:translateX(0); }
  }
    /* 백드롭: 열렸을 때만 표시 */
    #sidebar-backdrop { display: none; }
    body.sidebar-open #sidebar-backdrop { display: block; }
  }

  /* 데스크탑에선 백드롭 강제 숨김 */
  @media (min-width: 1025px) {
    #sidebar-backdrop { display: none !important; }
  }
