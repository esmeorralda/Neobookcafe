<% unless user_signed_in? %>
  <%= render "shared/login_modal" %>

  <script nonce="<%= content_security_policy_nonce %>">
  (function () {
    function getModal(){ return document.getElementById('sign_in_modal'); }

    function openModal() {
      const modal = getModal(); if (!modal) return;
      modal.classList.remove('hidden');
      const Modal = window.bootstrap?.Modal;
      if (Modal?.getOrCreateInstance) {
        Modal.getOrCreateInstance(modal).show();
      } else {
        modal.style.display = 'block';
        modal.classList.add('show');
        document.body.classList.add('modal-open');
      }
    }

    function bindGuestLoginModal() {
      const modal = getModal(); if (!modal || modal.dataset.bound === '1') return;
      modal.dataset.bound = '1';

      // ✅ requires_auth 전용 트리거
      document.addEventListener('click', function(e){
        const trigger = e.target.closest('[data-requires-auth="true"]');
        if (!trigger) return;
        e.preventDefault(); // 페이지 이동 방지
        openModal();
      });

      // 부트스트랩 닫힘 시 hidden 복원
      modal.addEventListener('hidden.bs.modal', function(){
        modal.classList.add('hidden');
      });
    }

    bindGuestLoginModal();
  })();
  </script>
<% end %>


