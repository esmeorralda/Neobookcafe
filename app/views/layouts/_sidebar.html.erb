<script nonce="<%= content_security_policy_nonce %>">
(function () {
  const BP = 1024; // px: 이 이하에서 오프캔버스 모드

  function bindSidebarToggle() {
    const btn      = document.getElementById('sidebar-toggle');
    const nav      = document.getElementById('left-nav');
    const backdrop = document.getElementById('sidebar-backdrop');
    if (!btn || !nav) return;

    function open() {
      document.body.classList.add('sidebar-open');
      btn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden'); // 모바일에서 배경 스크롤 방지
      if (backdrop) backdrop.classList.remove('hidden');
    }
    function close() {
      document.body.classList.remove('sidebar-open');
      btn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
      if (backdrop) backdrop.classList.add('hidden');
    }
    function toggle() {
      if (document.body.classList.contains('sidebar-open')) close(); else open();
    }

    if (!btn.dataset.bound) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', toggle);
    }
    if (backdrop && !backdrop.dataset.bound) {
      backdrop.dataset.bound = '1';
      backdrop.addEventListener('click', close);
    }

    // 화면이 넓어지면(데스크탑) 강제로 닫기
    function handleResize() {
      if (window.innerWidth > BP) close();
    }
    if (!window.__sidebarResizeBound) {
      window.__sidebarResizeBound = true;
      window.addEventListener('resize', handleResize);
    }

    const closeBtn = document.getElementById('sidebar-close');
if (closeBtn && !closeBtn.dataset.bound) {
  closeBtn.dataset.bound = '1';
  closeBtn.addEventListener('click', close); // ← 위에서 정의한 close() 호출
}

  }

  document.addEventListener('turbo:load', bindSidebarToggle);
  document.addEventListener('DOMContentLoaded', bindSidebarToggle);
})();
</script>
