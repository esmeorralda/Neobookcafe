<% if user_signed_in? %>
<div class="nav-items flex items-center space-x-6">
  <!-- 알림 버튼 -->
  <button id="toggle-notification" class="text-[14px] text-[#333] no-underline flex items-center nav-item">
    <img src="<%= asset_path('icon/alarm.svg') %>" alt="Notification" class="w-5 h-5" />
  </button>

  <!-- 프로필 버튼 -->
  <button id="toggle-right-sidebar" class="text-[14px] text-[#333] no-underline nav-item">
    프로필
  </button>

  <!-- 설정 -->
  <%= link_to "설정", "#",
      class: "open-settings-modal text-[14px] text-[#333] underline nav-item",
      data: { url: settings_path } %>

<% if show_dashboard_link? %>
  <%= link_to "Dashboard", dashboard_path, class: "nav-item" %>
<% end %>

  <!-- 로그아웃 -->
  <%= button_to "로그아웃",
        destroy_user_session_path,
        method: :delete,
        form: { data: { turbo_confirm: "정말 로그아웃 하시겠습니까?" } },
        class: "text-[14px] text-[#333] no-underline nav-item" %>
</div>

<% else %>
  <div class="nav-items">
    <%= link_to '로그인', '#sign_in_modal',
      id: 'sign_in_button',
      class: "nav-item",
      data: { requires_auth: true, bs_toggle: 'modal', bs_target: '#sign_in_modal' } %>
  </div>
<% end %>
