<!-- app/views/shared/_login_modal.html.erb -->
<div class="modal fade hidden" id="sign_in_modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content"><!-- position: relative는 CSS에서 줄게요 -->

      <!-- ✅ 하단 우측 코너 닫기 버튼 (유틸 클래스 제거) -->
      <button type="button"
              class="close-text-btn"
              data-bs-dismiss="modal"
              aria-label="Close">닫기</button>

      <div class="modal-body pb-5">
        <%= render 'devise/sessions/form' %>
      </div>


    </div>
  </div>
</div>

<style>
  /* ⚠ 전역 .modal 오버라이드는 절대 금지! (Bootstrap 동작 깨짐) */

  /* 가운데 정렬 + 너비만 ID 범위로 커스터마이즈 */
 #sign_in_modal {
  position: fixed !important;   /* 오버레이 보장 */
  inset: 0 !important;          /* top/right/bottom/left: 0 */
  z-index: 70000 !important;    /* 페이지 어떤 요소보다 위 */
}
/* 너비/비주얼 */
  #sign_in_modal .modal-dialog { max-width: 380px; margin: 20vh auto 0 !important; }
  #sign_in_modal .modal-content {
    position: relative; /* ⬅️ 닫기 버튼 절대배치 기준 */
    border: none;
    border-radius: 0;
    box-shadow: 0 4px 10px rgba(124,98,67,.3);
  }
  #sign_in_modal .modal-body { padding: 30px 40px; color: #5a4a2a; background: #fff; }

  /* 제목 */
  #sign_in_modal h2 { margin-bottom: 20px; font-weight: 700; font-size: 20px; text-align: center; }

  /* 입력 필드 */
  #sign_in_modal input[type="email"], #sign_in_modal input[type="password"] {
    width: 100%; padding: 10px 12px; margin-bottom: 15px;
    border: 1.8px solid #a5947b; border-radius: 0; font-size: 15px;
    background-color: #faf7ef; color: #5a4a2a; transition: border-color .3s, background-color .3s;
  }
  #sign_in_modal input[type="email"]:focus, #sign_in_modal input[type="password"]:focus {
    border-color: #7c6243; outline: none; background-color: #fff;
  }

  /* 로그인 버튼 */
  #sign_in_modal button[type="submit"], #sign_in_modal input[type="submit"] {
    display: block; margin: 10px auto 0; padding: 7px 52px;
    font-size: 17px; font-weight: 500; background-color: #7c6243; color: #f7f3e9;
    border: none; box-shadow: 0 3px 5px rgba(124,98,67,.6); transition: background-color .3s; cursor: pointer;
  }
  #sign_in_modal button[type="submit"]:hover, #sign_in_modal input[type="submit"]:hover { background-color: #5a4a2a; }

  /* ✅ 하단 우측 코너 텍스트 닫기 버튼(절대 위치 확정) */
  #sign_in_modal .close-text-btn {
    background: transparent; border: 0; padding: 6px 10px;
    font-size: 14px; font-weight: 600; color: #7c6243; cursor: pointer;
  }
  #sign_in_modal .close-text-btn:hover { text-decoration: underline; color: #5a4a2a; }
  #sign_in_modal .modal-content > .close-text-btn {
    position: absolute; right: 12px; bottom: 12px; /* ⬅️ 여기! */
  }
</style>
<script>
(function () {
  const DEBUG = true;

  function log(group, obj) {
    if (!DEBUG) return;
    try {
      console.groupCollapsed(group);
      Object.entries(obj || {}).forEach(([k, v]) => console.log(k, v));
      console.groupEnd();
    } catch (e) {}
  }

  function resetLoginModal() {
    const el = document.getElementById('sign_in_modal');
    if (!el) return;
    el.classList.remove('show');
    el.style.removeProperty('display');
    document.querySelector('.modal-backdrop')?.remove();
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('paddingRight');
  }

  function showFlashSuccess(message) {
    if (!message) return; // ✅ 기본문구 제거 (무조건 뜨는 문제 차단)
    const flash = document.getElementById('flash-container');
    if (flash) {
      flash.innerHTML = '<div class="alert alert-success mb-2" role="alert">' + message + '</div>';
    } else {
      alert(message);
    }
  }

  function showFlashError(message) {
    const msg = message || '이메일 또는 비밀번호가 올바르지 않습니다.';
    const flash = document.getElementById('flash-container');
    if (flash) {
      flash.innerHTML = '<div class="alert alert-danger mb-2" role="alert">' + msg + '</div>';
    } else {
      alert(msg);
    }
  }

  function hideModal(modalEl) {
    const Modal = window.bootstrap?.Modal;
    if (Modal?.getOrCreateInstance) {
      Modal.getOrCreateInstance(modalEl).hide();
      return;
    }
    modalEl.classList.remove('show');
    modalEl.style.display = 'none';
    document.body.classList.remove('modal-open');
    document.body.style.removeProperty('paddingRight');
    document.querySelector('.modal-backdrop')?.remove();
  }

  function bind() {
    resetLoginModal();

    const modalEl = document.getElementById('sign_in_modal');
    if (!modalEl) return;

    // 닫기 버튼
    const closeBtns = modalEl.querySelectorAll('.close-text-btn, [data-bs-dismiss="modal"]');
    closeBtns.forEach((btn) => {
      if (btn.dataset.boundClose === '1') return;
      btn.dataset.boundClose = '1';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        hideModal(modalEl);
      });
    });

    // 폼 핸들러 (UJS: ajax:success / ajax:error)
    const form = modalEl.querySelector('#login-form') || modalEl.querySelector('form');
    if (form && !form.__bound) {
      form.__bound = true;

      form.addEventListener('ajax:success', (e) => {
        const detail = e.detail || [];
        const data = detail[0] || {};
        const xhr  = detail[2];
        const ok = (xhr?.getResponseHeader?.('X-Auth-Result') === 'success') || data.success === true;
      
        if (!ok) { showFlashError((data.errors && data.errors.join('\n')) || '로그인 실패'); return; }
      
        // (선택) 플래시를 새로고침 뒤에 보여주고 싶으면 저장
        try { if (data.notice) sessionStorage.setItem('__flash_notice', data.notice); } catch(_) {}
      
        // 무한 새로고침 방지 플래그
        try { sessionStorage.setItem('__post_login_reload', '1'); } catch(_) {}
      
        // 모달 닫기
        hideModal(document.getElementById('sign_in_modal'));
      
        // 즉시 전체 새로고침/네비게이션
        const url = data.redirect_url || window.location.href;
      
        if (window.Turbo?.visit) {
          // Turbo 사용 시 서버 렌더를 강제로 재요청
          Turbo.visit(url, { action: 'replace' });
        } else if ('replaceState' in history) {
          // Turbo 없으면 전통 방식
          window.location.replace(url);   // 히스토리 오염 없이 이동
        } else {
          window.location.reload();       // 최후의 수단
        }
      
        // 아래 로직(교체/재바인딩)은 어차피 새 페이지로 갈 거라 불필요
      });
      

      form.addEventListener('ajax:error', (e) => {
        const detail = e.detail || [];
        const data = detail[0] || {};
        const status = detail[2]?.status;
        const hdr = detail[2]?.getResponseHeader?.('X-Auth-Result');
        const msg = (data.errors && data.errors.join('\n')) || '이메일 또는 비밀번호가 올바르지 않습니다.';

        log('[login] ajax:error', { data, status, hdr });

        showFlashError(msg);
      });

      // ❌ Turbo 경로는 비활성화했으므로 핸들러 제거
      // form.addEventListener('turbo:submit-end', ... )  <-- 삭제
    }
  }

  document.addEventListener('turbo:load', bind);
  document.addEventListener('DOMContentLoaded', bind);
})();
</script>
