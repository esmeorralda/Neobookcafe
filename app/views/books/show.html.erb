<div class="relative max-w-4xl mx-auto space-y-10 px-6 mt-10">
  <!-- 상단 영역: 제목과 버튼을 flex로 분리 -->
  <div class="flex justify-between items-start">
    <!-- 왼쪽: 제목, 저자, 진행률 -->
    <div>
      <div class="flex items-center space-x-2 mb-4">
        <h1 class="text-2xl font-bold whitespace-nowrap mt-5"><%= @book.title %></h1>
        <p class="text-sm text-gray-600 whitespace-nowrap self-end">
          <%= @book.author.present? ? @book.author : "책 저자 정보 없음"  %>
        </p>
      </div>

      <% total_pages = @book.total_pages || 0 %>
      <% current_page = @book.current_page || 0 %>

      <!-- 쪽수 및 진행률 -->
      <div class="flex items-center text-sm" style="color:#815e4e;font-weight:350;">
        <% if @book.current_page.present? && @book.total_pages.present? && @book.total_pages > 0 %>
          <span><%= @book.current_page %>쪽 · <%= number_to_percentage((@book.current_page.to_f / @book.total_pages * 100).round, precision: 0) %> · </span>
          <span id="progress1" class="ml-2 inline-block" style="width:20px;height:20px;"
                data-current-page="<%= current_page %>"
                data-total-pages="<%= total_pages %>"></span>
        <% else %>
          페이지 정보 없음
        <% end %>
      </div>
    </div>

    <!-- 오른쪽: 버튼 -->
    <div class="flex flex-col space-y-2 mt-3">
      <%= link_to "메모 추가", new_book_note_path(@book), class: "bg-[#644536] text-white px-3 py-1 text-sm" %>
      <%= link_to "책 편집", edit_book_path(@book), class: "border px-3 py-1 text-sm text-center" %>
    </div>
  </div>

  <div class="max-h-[70vh] overflow-y-auto pr-1">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      <% corner_map = {
        '#FFFFCD' => '#E0E0A7', # 노랑
        '#E3FFDC' => '#B5D3AE', # 연두
        '#FFF0F8' => '#EDC6DB', # 핑크
        '#E1FAFF' => '#B1D6DD'  # 하늘
      } %>

      <% @book.notes.order(created_at: :desc).each do |note| %>
        <% bg_hex  = (note.color.presence || '#FFFFCD').to_s.upcase %>
        <% corner  = corner_map[bg_hex] || '#E5E5D7' %>

        <!-- 랩퍼: 정사각형 + 코너 변수 -->
        <div class="sticky-wrap" style="--fold:40px; --note-bg:<%= bg_hex %>; --corner:<%= corner %>;">
          <!-- 카드(클릭 영역) -->
          <%= link_to note_path(note), class: "sticky block" do %>
            <!-- 상단 메타 -->
            <div class="absolute top-3 left-3 text-[13px] text-gray-600 font-medium">
              <% if note.page_from && note.page_to %>
                <%= note.page_from %>~<%= note.page_to %>쪽
              <% elsif note.page_from %>
                <%= note.page_from %>쪽
              <% end %>
            </div>
            <div class="absolute top-3 right-3 text-[13px] text-gray-600">
              <%= note.created_at.strftime('%d/%m/%Y') %>
            </div>

            <!-- 내용 (줄 단위 클램프 + 서버사이드 truncate) -->
            <div class="content">
              <%= truncate(note.memo.to_s, length: 220) %>
            </div>

            <!-- 바닥 그림자 -->
            <div class="sticky-shadow"></div>
          <% end %>

          <!-- 접힌 코너: 앞면 + 뒷면 (회전 없음, 좌표 고정) -->
          <span class="fold-core"></span>
          <span class="fold-under"></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
/* 랩퍼: 카드와 코너를 정확히 포개기 (정사각형 강제) */
.sticky-wrap{
  position:relative;
  width:100%;
}

/* 카드 본체: 정사각형 + 우하단 접힘 공간 */
.sticky{
  position:relative; width:100%; aspect-ratio:1/1;
  padding:24px 26px 28px 26px;
  font-family:ui-serif,Georgia,Cambria,"Times New Roman",Times,serif;
  background:var(--note-bg,#FFFFCD);
  clip-path:polygon(
    0 0, 100% 0,
    100% calc(100% - var(--fold,40px)),
    calc(100% - var(--fold,40px)) 100%,
    0 100%
  );
  box-shadow:0 12px 24px rgba(0,0,0,.22);
  border-radius:2px;
}

/* 내용: 줄 단위 클램프 (정사각형 넘침 방지) */
.sticky .content{
  color:#1f2937; font-size:14px; line-height:1.75;
  white-space:pre-line; overflow:hidden;
  display:-webkit-box; -webkit-line-clamp:9; -webkit-box-orient:vertical; /* 필요시 8~10 사이 조절 */
}

/* 바닥 타원 그림자 */
.sticky-shadow{
  pointer-events:none;
  position:absolute; left:18px; right:calc(var(--fold,40px) + 12px); bottom:-8px; height:12px;
  border-radius:9999px; background:rgba(0,0,0,.10); filter:blur(8px);
}

/* ▽ 접힌 코너 앞면(코너 색) — 회전 없이 정확히 포개짐 */
.fold-core{
  position:absolute; right:0; bottom:0;
  width:var(--fold,28px); height:var(--fold,28px);
  background:var(--corner, #E0E0A7);
  clip-path:polygon(0 0, 100% 0, 100% 100%);
   transform:rotate(-90deg);
  filter: drop-shadow(0 1px 0 rgba(0,0,0,0.12)) drop-shadow(1px 0 0 rgba(0,0,0,0.10));
}


</style>

<script src="https://cdn.jsdelivr.net/npm/progressbar.js"></script>
<script>
(function () {
  // ───────── State ─────────
  const BAR_MAP = new WeakMap(); // container => ProgressBar instance

  // ───────── Skeleton UI ─────────
  function ensureStyles() {
    if (document.getElementById('progress-skeleton-style')) return;
    const css = `
      #progress1.progress-skeleton, [data-progress-circle].progress-skeleton {
        position: relative;
        border-radius: 9999px;
        background: linear-gradient(90deg, #f7f2ed 0%, #f0e6dd 50%, #f7f2ed 100%);
        animation: pb-pulse 1.2s ease-in-out infinite;
      }
      #progress1.progress-skeleton .progress-skeleton-fill,
      [data-progress-circle].progress-skeleton .progress-skeleton-fill {
        position: absolute; inset: 4px;
        border-radius: 9999px; background: #ffffff;
      }
      @keyframes pb-pulse { 0%{opacity:.85} 50%{opacity:1} 100%{opacity:.85} }
    `;
    const style = document.createElement('style');
    style.id = 'progress-skeleton-style';
    style.textContent = css;
    document.head.appendChild(style);
  }
  function skeletonOn(el) {
    if (!el) return;
    el.classList.add('progress-skeleton');
    if (!el.querySelector('.progress-skeleton-fill')) {
      const fill = document.createElement('div');
      fill.className = 'progress-skeleton-fill';
      el.appendChild(fill);
    }
  }
  function skeletonOff(el) {
    if (!el) return;
    el.classList.remove('progress-skeleton');
    const f = el.querySelector('.progress-skeleton-fill');
    if (f) f.remove();
  }

  // ───────── Wait until ProgressBar.js is ready ─────────
  function waitForProgressBar(maxMs = 5000) {
    return new Promise((resolve, reject) => {
      const start = performance.now();
      (function poll() {
        if (window.ProgressBar && typeof window.ProgressBar.Circle === 'function') {
          resolve();
          return;
        }
        if (performance.now() - start > maxMs) {
          reject(new Error('ProgressBar.js load timeout'));
          return;
        }
        setTimeout(poll, 100);
      })();
    });
  }

  // ───────── Init Progress Circles ─────────
  function initProgressCircles() {
    const nodes = [];
    const direct = document.getElementById('progress1');
    if (direct) nodes.push(direct);
    document.querySelectorAll('[data-progress-circle]').forEach(n => {
      if (n !== direct) nodes.push(n);
    });

    nodes.forEach(container => {
      if (!container || container.dataset.pbBound === '1') return;
      container.dataset.pbBound = '1';

      const currentPage = Number(container.dataset.currentPage) || 0;
      const totalPages  = Number(container.dataset.totalPages)  || 0;
      const progress    = (currentPage > 0 && totalPages > 0) ? Math.min(currentPage / totalPages, 1) : 0;

      // Skeleton 먼저
      skeletonOn(container);

      // 라이브러리 준비되면 그때 실제 바 렌더
      waitForProgressBar().then(() => {
        // 기존 인스턴스 정리
        if (BAR_MAP.has(container)) {
          try { BAR_MAP.get(container).destroy(); } catch(e) {}
          BAR_MAP.delete(container);
        }
        // 스켈레톤 제거 후 실제 원형 프로그레스 생성
        skeletonOff(container);
        const bar = new ProgressBar.Circle(container, {
          strokeWidth: 12,
          color: '#815e4e',
          trailColor: '#fff',
          trailWidth: 1,
          easing: 'easeInOut',
          duration: 1000
        });
        BAR_MAP.set(container, bar);
        bar.animate(progress);
      }).catch(() => {
        // 타임아웃 시 스켈레톤 유지 (조용히 실패)
      });
    });
  }

  // Turbo 캐시로 들어가기 전 정리 (중복 SVG 방지)
  function cleanupBeforeCache() {
    const all = [];
    const direct = document.getElementById('progress1');
    if (direct) all.push(direct);
    document.querySelectorAll('[data-progress-circle]').forEach(n => {
      if (n !== direct) all.push(n);
    });

    all.forEach(container => {
      if (BAR_MAP.has(container)) {
        try { BAR_MAP.get(container).destroy(); } catch(e) {}
        BAR_MAP.delete(container);
      }
      Array.from(container.querySelectorAll('svg, .progressbar-text')).forEach(n => n.remove());
      container.removeAttribute('data-pb-bound');
    });
  }

  // ───────── Export 버튼 (안전한 복제/위임) ─────────
  function initExportButtons() {
    if (document.body.dataset.exportDelegBound === '1') return;
    document.body.dataset.exportDelegBound = '1';

    // 이벤트 위임: 새로 삽입된 버튼도 즉시 동작
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.export-btn');
      if (!btn) return;

      const bookId = btn.dataset.bookId;
      if (!bookId) return;

      if (!btn.dataset.busy) {
        btn.dataset.busy = '1';
        const original = btn.textContent;
        btn.textContent = original && original.trim().length ? original : '내보내는 중...';
        btn.disabled = true;

        // 다운로드 트리거
        window.location.href = `/books/${encodeURIComponent(bookId)}/export_notes`;

        // 적당한 딜레이 후 버튼 원복 (다운로드는 계속 진행)
        setTimeout(() => {
          btn.textContent = original;
          btn.disabled = false;
          delete btn.dataset.busy;
        }, 1500);
      }
    }, { passive: true });
  }

  // ───────── Bootstrap ─────────
  function init() {
    ensureStyles();
    initProgressCircles();
    initExportButtons();
  }

  document.addEventListener('DOMContentLoaded', init); // 최초 로드
  document.addEventListener('turbo:load', init);       // Turbo 네비 완료
  document.addEventListener('turbo:render', init);     // Turbo 캐시 렌더
  document.addEventListener('turbo:before-cache', cleanupBeforeCache); // 캐시 저장 직전 정리
})();
</script>
